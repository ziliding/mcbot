# Copy to .env (gitignored) and fill in.

# Minecraft. Set MC_EULA=TRUE only after reading https://aka.ms/MinecraftEULA
MC_EULA=FALSE
MC_VER=26.1
MC_NAME=mcbot
# Default target for the legacy cmds.jsonl come/follow/look commands
MC_DEFAULT_PLAYER=steve

# Matrix: the bot's own account on the homeserver
# MATRIX_HOMESERVER defaults to http://tailscale:6167 (matrix compose network)
MATRIX_ACCESS_TOKEN=
# Unencrypted room shared with Hermes: !roomid:example.com or #alias:example.com
MATRIX_ROOM=
# Comma-separated Matrix ids whose messages are spoken in game (Hermes's user).
# Empty = everyone in the room except the bot.
MATRIX_ALLOWED_SENDERS=

# MCP endpoint (http://127.0.0.1:3333/mcp) bearer token. Generate: openssl rand -hex 32
MCP_TOKEN=
